{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "7.4",
    "wp": "6.6.2"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://downloads.wordpress.org/plugin/woocommerce.9.6.2.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "wp-cli",
      "command": "wp language core install fr_FR"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "woocommerce_custom_orders_table_enabled": "no",
        "woocommerce_custom_orders_table_data_sync_enabled": "no"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "jeytech-order-transfer-qr/jeytech-order-transfer-qr.php"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-content/otqr-dev/i18n-smoke.php';"
    }
  ]
}
