{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "7.4",
    "wp": "7.1.2"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://downloads.wordpress.org/plugin/woocommerce.11.1.2.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "wp-cli",
      "command": "wp language core install fr_FR"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "woocommerce_custom_orders_table_enabled": "no",
        "woocommerce_custom_orders_table_data_sync_enabled": "no"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "jeytech-order-transfer-qr/jeytech-order-transfer-qr.php"
    },
    {
      "step": "wp-cli",
      "command": "wp eval-file /wordpress/wp-content/otqr-dev/scenario-test.php"
    }
  ]
}
